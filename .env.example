# Copie este arquivo para ".env" (ele já está no .gitignore) e preencha.
# No Supabase: botão "Connect" do projeto -> "Session pooler".
#
# Use o Session pooler (porta 5432): funciona em redes só-IPv4 e aceita prepared statements.
# A conexão direta (db.<ref>.supabase.co) é só IPv6 no plano gratuito.
# Se usar o Transaction pooler (porta 6543), acrescente &prepareThreshold=0 na URL.

DB_URL=jdbc:postgresql://aws-0-REGIAO.pooler.supabase.com:5432/postgres?sslmode=require
DB_USER=postgres.SEU_PROJECT_REF
DB_PASS=sua_senha_do_banco
